{
	"name": "database",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"root": "packages/database",
	"sourceRoot": "packages/database/src",
	"tags": ["scope:database", "type:lib", "language:ts"],
	"implicitDependencies": ["types"],
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/database",
				"command": "bun run lint"
			}
		},
		"format": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/database",
				"command": "bun run format"
			}
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/database",
				"command": "bun run check"
			}
		},
		"database:generate": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/drizzle"],
			"options": {
				"cwd": "packages/database",
				"command": "bun run database:generate"
			}
		},
		"database:migrate": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/database",
				"command": "bun run database:migrate"
			}
		},
		"database:studio": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/database",
				"command": "bun run database:studio"
			}
		}
	}
}
