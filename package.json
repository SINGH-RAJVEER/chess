{
	"name": "chess-monorepo",
	"private": true,
	"packageManager": "bun@1.2.22",
	"workspaces": [
		"apps/web",
		"apps/engine",
		"packages/types"
	],
	"scripts": {
		"lockfile:generate": "bun install --lockfile-only",
		"dev": "nx run-many -t dev -p api engine web --parallel=3",
		"build": "nx run-many -t build --all",
		"test": "nx run-many -t test --all",
		"lint": "nx run-many -t lint --all",
		"format": "nx run-many -t format --all",
		"check": "nx run-many -t check --all",
		"typecheck": "nx run-many -t typecheck --all",
		"affected:build": "nx affected -t build",
		"affected:lint": "nx affected -t lint",
		"affected:test": "nx affected -t test",
		"api:migrate": "nx run api:migrate",
		"clean": "nx run-many -t clean --all"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"nx": "^23.0.0"
	}
}
