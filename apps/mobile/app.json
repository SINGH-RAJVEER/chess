{
	"expo": {
		"name": "SixtyFour",
		"slug": "sixtyfour-mobile",
		"scheme": "sixtyfour",
		"version": "0.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#09090b"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.sixtyfour.mobile"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#09090b"
			},
			"package": "com.sixtyfour.mobile"
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router"],
		"experiments": {
			"typedRoutes": true
		},
		"newArchEnabled": true
	}
}
