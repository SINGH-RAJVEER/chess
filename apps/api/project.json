{
	"name": "api",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"root": "apps/api",
	"sourceRoot": "apps/api/src",
	"tags": ["scope:api", "type:app", "language:ts"],
	"implicitDependencies": ["db", "types"],
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run dev"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"cwd": "apps/api",
				"command": "bun run build"
			}
		},
		"start": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run start"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run typecheck"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run lint"
			}
		},
		"format": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run format"
			}
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run check"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/api",
				"command": "bun run clean"
			}
		}
	}
}
