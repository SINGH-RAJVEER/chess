{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Chess",
    "version": "0.1.0",
    "identifier": "dev.chess.desktop",
    "build": {
        "devUrl": "http://localhost:3000",
        "frontendDist": "../../web/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Chess",
                "width": 1280,
                "height": 832,
                "minWidth": 960,
                "minHeight": 640,
                "center": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
